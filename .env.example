# Copy to .env, set your OpenRouter key, and reload the app. Never commit .env.
OPENROUTER_API_KEY=
# Existing OpenRouter model setting; the google/ namespace is a model author,
# not a direct Google AI Studio connection. Only free Gemma endpoints are supported.
COPILOT_MODEL=google/gemma-4-31b-it:free

# Sample evaluation date; use 2027-01-15 for the released test field.
COPILOT_AS_OF_DATE=2026-10-16
# IANA timezone for private-history dates and runtime operational reports.
COPILOT_FIELD_TIMEZONE=UTC
# Set COPILOT_REPORT_DATE=2027-01-15 for the test demo's operational 'yesterday'.
# Private chat dates always use the real clock.
# COPILOT_REPORT_DATE=

# Optional overrides; relative paths resolve from the launch directory.
# COPILOT_DB_PATH=data/copilot.sqlite3
# COPILOT_DATASET_PATH=challenge-dataset/sample-data
# COPILOT_REQUEST_TIMEOUT=90
# COPILOT_MAX_TOOL_ROUNDS=3
# Rough input-size guard: UTF-8 JSON bytes / 4, NOT a measured tokenizer count.
# Actual model-context limits and rate limits are enforced by OpenRouter/upstream.
# COPILOT_MAX_INPUT_TOKENS=12000
# COPILOT_MAX_OUTPUT_TOKENS=4096
