# Copy to .env, set your key, and reload the app. Never commit .env.
COPILOT_PROVIDER=google
COPILOT_MODEL=gemma-4-26b-a4b-it
GOOGLE_API_KEY=
# GEMINI_API_KEY= is also accepted when GOOGLE_API_KEY is blank.

# Alternative: COPILOT_PROVIDER=openrouter, COPILOT_MODEL=google/gemma-4-31b-it:free.
OPENROUTER_API_KEY=

# Sample evaluation date; use 2027-01-15 for the released test field.
COPILOT_AS_OF_DATE=2026-10-16
# IANA timezone for private-history dates and runtime operational reports.
COPILOT_FIELD_TIMEZONE=UTC
# Set COPILOT_REPORT_DATE=2027-01-15 for the test demo's operational 'yesterday'.
# Private chat dates always use the real clock.
# COPILOT_REPORT_DATE=

# Optional overrides; relative paths resolve from the launch directory.
# COPILOT_DB_PATH=data/copilot.sqlite3
# COPILOT_DATASET_PATH=challenge-dataset/sample-data
# COPILOT_REQUEST_TIMEOUT=90
# COPILOT_MAX_TOOL_ROUNDS=3
# Max measured input size per Google generation request; not a live TPM allowance.
# COPILOT_MAX_INPUT_TOKENS=12000
# COPILOT_MAX_OUTPUT_TOKENS=4096

# Shared app-side input pacing. Set the limit to the selected model's actual project allowance.
COPILOT_GOOGLE_TPM_LIMIT=16000
COPILOT_GOOGLE_TPM_HEADROOM=1500
# Use the same non-secret label for keys belonging to the same Google project.
COPILOT_GOOGLE_QUOTA_GROUP=hackathon-field-demo
